# ── 扶摇（同花顺金融数据 API）──────────────────────────────
# 二选一：直接给 Key，或给一个只有 Key 的本地文件路径（推荐，避免 Key 出现在命令历史里）
FUYAO_API_KEY=
FUYAO_API_KEY_FILE=~/.config/mingshai/fuyao.key

# ── 大模型（只用于意图解析和白话解读；不配置时自动用规则解析）──
# anthropic：Claude，默认模型 claude-opus-5-5
# openai_compat：DeepSeek / 通义 / Kimi 等 OpenAI 兼容接口，需同时填 BASE_URL 和 MODEL
MINGSHAI_LLM_PROVIDER=
MINGSHAI_LLM_API_KEY_FILE=~/.config/mingshai/llm.key
MINGSHAI_LLM_BASE_URL=
MINGSHAI_LLM_MODEL=
MINGSHAI_LLM_EFFORT=low
# AI 调用总额上限（美元，总额，不按月清零）。到上限前按最坏情况预留，额度不够就永久切断并删除 Key 文件
MINGSHAI_LLM_BUDGET_USD=5
MINGSHAI_LLM_SPENT_OFFSET_USD=0   # 账本之外已经花掉的金额（如开发期调用）

# ── 运行 ──────────────────────────────────────────────────
MINGSHAI_DATA=live            # live：真实快照；demo：合成演示数据
MINGSHAI_DATA_DIR=./data      # 快照、台账、保存的策略
MINGSHAI_AUTO_BUILD=1         # 有扶摇 Key 时：没快照就自动构建，交易日 16:30 后日更
MINGSHAI_ADMIN_TOKEN=         # 手动触发构建 /api/admin/build 的口令
